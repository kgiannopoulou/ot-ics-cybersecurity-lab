<!--
  Wazuh custom rules for the OT/ICS lab.
  Install: /var/ossec/etc/rules/local_rules.xml on the Wazuh manager, then
           systemctl restart wazuh-manager
  Rule ID range 100200-100299 is reserved for this lab.
  Wazuh's built-in MITRE database covers Enterprise ATT&amp;CK only, so ATT&amp;CK for ICS
  technique IDs are carried as groups (mitre_ics_Txxxx) and can be filtered in the dashboard.
-->

<group name="ot_ics,suricata,">

  <!-- Any Suricata alert generated by the lab's OT rule range (SID 9000001-9000099) -->
  <rule id="100200" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^90000\d\d$</field>
    <description>OT/ICS: Suricata OT rule fired - $(alert.signature)</description>
    <group>ot_ics_ids,</group>
  </rule>

  <!-- Unauthorised client talking Modbus to the PLC -->
  <rule id="100201" level="10">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id">^9000001$|^9000002$</field>
    <description>OT/ICS: Modbus session to PLC from unauthorised host $(src_ip)</description>
    <group>mitre_ics_T0886,ot_ics_policy_violation,</group>
  </rule>

  <!-- Process-impacting writes: pump/mode coils, setpoints, writes from non-HMI -->
  <rule id="100202" level="13">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id">^9000003$|^9000004$|^9000005$|^9000013$</field>
    <description>OT/ICS: Unauthorised Modbus write affecting process control from $(src_ip)</description>
    <group>mitre_ics_T0855,mitre_ics_T0836,ot_ics_process_impact,</group>
  </rule>

  <!-- Reconnaissance -->
  <rule id="100203" level="7">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id">^9000006$|^9000007$|^9000009$</field>
    <description>OT/ICS: Modbus reconnaissance from $(src_ip)</description>
    <group>mitre_ics_T0846,mitre_ics_T0888,ot_ics_recon,</group>
  </rule>

  <!-- Correlation: recon (100203) followed by a process write from the same source within 10 min -->
  <rule id="100204" level="15" timeframe="600">
    <if_sid>100202</if_sid>
    <if_matched_sid>100203</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>OT/ICS: Recon followed by unauthorised write from $(src_ip) - possible ICS attack chain</description>
    <group>mitre_ics_T0846,mitre_ics_T0855,ot_ics_attack_chain,</group>
  </rule>

  <!-- OT host egress to the internet -->
  <rule id="100205" level="12">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id">^9000010$</field>
    <description>OT/ICS: OT asset $(src_ip) attempted external connection</description>
    <group>mitre_ics_T0884,</group>
  </rule>
</group>

<group name="ot_ics,firewall,">
  <!-- pfSense filterlog: block on the IT->OT Modbus rule -->
  <rule id="100210" level="10">
    <if_group>firewall</if_group>
    <match>block</match>
    <regex>,10\.10\.10\.\d+,10\.30\.30\.\d+,\d+,502,</regex>
    <description>OT/ICS: Firewall blocked Modbus from IT zone into OT</description>
    <group>mitre_ics_T0886,</group>
  </rule>

  <!-- Docker build: iptables LOG prefix from firewall/iptables-it-ot.sh -->
  <rule id="100211" level="10">
    <if_sid>4100</if_sid>
    <match>FW-DENY-MODBUS-IT2OT</match>
    <description>OT/ICS: IT->OT Modbus blocked by conduit firewall</description>
    <group>mitre_ics_T0886,</group>
  </rule>
</group>

<group name="ot_ics,hmi,">
  <!-- OpenPLC / HMI host: program upload or runtime stop seen in the agent's logs -->
  <rule id="100220" level="12">
    <match>Program upload|reload_program|stop_plc</match>
    <description>OT/ICS: PLC program change or runtime stop on $(hostname)</description>
    <group>mitre_ics_T0843,mitre_ics_T0881,</group>
  </rule>

  <!-- File integrity: PLC program / HMI project modified outside a change window -->
  <rule id="100221" level="12">
    <if_sid>550,554</if_sid>
    <field name="file">\.st$|/scadabr/|/openplc/</field>
    <description>OT/ICS: PLC program or HMI project file changed: $(file)</description>
    <group>mitre_ics_T0839,</group>
  </rule>
</group>
